package dao;

import java.sql.Connection;
import java.sql.PreparedStatement;

import DbConnection.DatabaseConnection;
import models.Product;

public class ProductDao {
	public static void insertProduct(Product p) {
		try {
			Connection conn = DatabaseConnection.createConnection();
			String sql  = "insert into product (pname,pimage,pprice,pcategory,sid) values(?,?,?,?,?)";
			PreparedStatement pst = conn.prepareStatement(sql);
			pst.setString(1,p.getPname());
			pst.setString(2, p.getPimage());
			pst.setInt(3,p.getPprice());
			pst.setString(4, p.getPcategory());
			pst.setInt(5, p.getSid());
			pst.executeUpdate();
			System.out.println("product upload");
		} catch (Exception e) {
			// TODO: handle exception
			e.printStackTrace();
		}
	}
}
