<%@page import="dao.ProductDao"%>
<%@page import="models.Product"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@include file="seller-header.jsp" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<% int pid =Integer.parseInt(request.getParameter("pid"));
Product p = ProductDao.getProductPid(pid);
%>

<div class="container-fluid py-5">
        <div class="container py-5">
            <div class="mx-auto text-center wow fadeIn" data-wow-delay="0.1s" style="max-width: 500px;">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Product Update</div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="wow fadeIn" data-wow-delay="0.3s">
                        <form action="product" method="post" enctype = "multipart/form-data">
                            <input type="hidden" name="pid" value="<%=p.getPid()%>"
								class="form-control" id="email">
                            
                            
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                 
								
								<div class="form-group">
								<img src="pimages/<%=p.getPimage()%>" alt="Image"
									class="img-fluid">
							</div>

                                        <input type="text" class="form-control" name="pname" value = "<%=p.getPname()%>"id="email" placeholder="Name">
                                        <label for="email">ProductName</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="file" class="form-control" name="pimage"value = "<%=p.getPimage()%>" id="email" placeholder="Email">
                                        <label for="email">ProductImage</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" name="pprice"value= "<%=p.getPprice()%>" id="email" placeholder="Password">
                                        <label for="email">ProductPrice</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" name="pcategory"value = "<%=p.getPcategory()%>" id="email" placeholder="Address">
                                        <label for="email">ProductCategory</label>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <button class="btn btn-primary w-100 py-3" name = "action" value = "update" type="submit">Update</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>