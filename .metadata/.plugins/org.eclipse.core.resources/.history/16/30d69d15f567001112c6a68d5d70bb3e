<%@page import="models.Product"%>
<%@page import="dao.ProductDao" %>
<%@page import="java.util.List"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@include file="seller-header.jsp"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<div class="container-fluid py-5" style="background-color: #f8f9fa; min-height: 100vh;">
    <div class="container">

        <%-- Declare list at the TOP before it's used anywhere --%>
        <%
            List<Product> list = ProductDao.getProductsBySid(s.getId());
        %>

        <!-- Table Card -->
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

            <!-- Card Header -->
            <div class="card-header d-flex justify-content-between align-items-center py-3 px-4"
                style="background: linear-gradient(135deg, #1a1a2e, #16213e); border: none;">
                <span class="text-white fw-semibold fs-6">
                    <i class="fa fa-list me-2"></i>Product Inventory
                </span>
                <span class="badge bg-primary rounded-pill">
                    <%=list.size()%> Products  <%-- Now works fine --%>
                </span>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #1a1a2e;">
                        <tr>
                            <th class="text-white py-3 px-4" style="width: 80px;">#</th>
                            <th class="text-white py-3">Image</th>
                            <th class="text-white py-3">Product Name</th>
                            <th class="text-white py-3">Price</th>
                            <th class="text-white py-3">Category</th>
                            <th class="text-white py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%
                            int count = 1;
                            for (Product p : list) {  
                        %>
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <td class="px-4 text-muted fw-semibold"><%=count++%></td>
                            <td>
                                <img src="pimages/<%=p.getPimage()%>"
                                    alt="<%=p.getPname()%>"
                                    style="width: 65px; height: 65px; object-fit: cover; border-radius: 10px;
                                           border: 2px solid #e9ecef; box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
                            </td>
                            <td>
                                <span class="fw-semibold text-dark"><%=p.getPname()%></span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2"
                                    style="background-color: #e8f5e9; color: #2e7d32; font-size: 0.85rem;">
                                    ₹ <%=p.getPprice()%>
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2"
                                    style="background-color: #e3f2fd; color: #1565c0; font-size: 0.85rem;">
                                    <%=p.getPcategory()%>
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="EditProductServlet?pid=<%=p.getPid()%>"
                                    class="btn btn-sm me-1 px-3"
                                    style="background-color: #1a1a2e; color: white; border-radius: 8px;">
                                    <i class="fa fa-edit me-1"></i>Edit
                                </a>
                                <a href="RemoveProductServlet?pid=<%=p.getPid()%>"
                                    class="btn btn-sm btn-danger px-3"
                                    style="border-radius: 8px;"
                                    onclick="return confirm('Remove <%=p.getPname()%>?')">
                                    <i class="fa fa-trash me-1"></i>Remove
                                </a>
                            </td>
                        </tr>
                        <% } %>

                        <% if (list.isEmpty()) { %>
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa fa-inbox fa-3x mb-3 d-block" style="color: #ccc;"></i>
                                No products found. <a href="seller-upload-product.jsp">Upload your first product</a>
                            </td>
                        </tr>
                        <% } %>

                    </tbody>
                </table>
            </div>

            <!-- Card Footer -->
            <div class="card-footer px-4 py-3 d-flex justify-content-between align-items-center"
                style="background-color: #f8f9fa; border-top: 1px solid #e9ecef;">
                <small class="text-muted">
                    Logged in as <strong><%=s.getName()%></strong>
                </small>
                <small class="text-muted">
                    Total: <strong><%=list.size()%></strong> product(s)
                </small>
            </div>

        </div>
    </div>
</div>
</body>
</html>